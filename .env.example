# Spring profile
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
UPLOAD_MAX_INPUT_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=11MB
UPLOAD_MAX_GENERATED_SIZE=20MB

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://naeil-db:5432/naeil_bank_dev
SPRING_DATASOURCE_USERNAME=naeil
SPRING_DATASOURCE_PASSWORD=change-me
# Deployment can also provide this for the container-network database password.
POSTGRES_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-at-least-32-bytes-long

# Kakao OAuth
KAKAO_CLIENT_ID=change-me
KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao/callback
KAKAO_CLIENT_SECRET=change-me

# OpenAI
OPENAI_API_KEY=change-me
OPENAI_MEAL_MODEL=gpt-5-mini
OPENAI_FACE_MODEL=gpt-5-mini
OPENAI_TIMEOUT=30s

# Web Push VAPID
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:admin@example.com

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
